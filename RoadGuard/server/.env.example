# ========================================
# RoadGuard Server — Environment Configuration Template
# Copy this file to server/.env and fill in your values.
# NEVER commit server/.env with real credentials to source control.
# ========================================

# --- Supabase Cloud Backend ---
SUPABASE_URL=https://your-project-ref.supabase.co

# Service Role Key (Required for server backend administrative queries)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Anon / Publishable Key (Fallback for client-level queries)
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# --- App Configuration ---
ROADGUARD_BUILD_TYPE=debug
ROADGUARD_DEMO_MODE=true
ROADGUARD_APP_VERSION=1.0.0
ROADGUARD_LOG_LEVEL=DEBUG

# --- ML Model Assets ---
ML_MODEL_FILENAME=roadguard_classifier_v1.tflite
ML_LABELS_FILENAME=roadguard_labels.txt

# --- BLE Configuration ---
BLE_SERVICE_UUID=6E400001-B5A3-F393-E0A9-E50E24DCCA9E
BLE_CHARACTERISTIC_UUID_TX=6E400003-B5A3-F393-E0A9-E50E24DCCA9E
BLE_CHARACTERISTIC_UUID_RX=6E400002-B5A3-F393-E0A9-E50E24DCCA9E
BLE_DEVICE_NAME_PREFIX=RoadGuard-ESP32
