# ========================================
# RoadGuard — Environment Configuration Template
# Copy this file to .env in your root or server/ directory and fill in your values.
# NEVER commit .env with real credentials to source control.
# ========================================

# --- Supabase Cloud Backend ---
# Obtain from your Supabase Dashboard: Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co

# Service Role Key (for server/Python backend ONLY — keep secret, never expose to clients!)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Anon / Publishable Key (for Android client and public browser access)
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# --- Android App Configuration (android/local.properties) ---
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_ANON_KEY=your-supabase-anon-key-here
# ROADGUARD_DEMO_MODE=true

# --- Application Runtime Flags ---
ROADGUARD_BUILD_TYPE=debug       # debug | release
ROADGUARD_DEMO_MODE=true         # true = simulation mode enabled; false = physical hardware required
ROADGUARD_APP_VERSION=1.0.0
ROADGUARD_LOG_LEVEL=DEBUG        # DEBUG | INFO | WARN | ERROR

# --- Machine Learning Model Assets ---
ML_MODEL_FILENAME=roadguard_classifier_v1.tflite
ML_LABELS_FILENAME=roadguard_labels.txt

# --- Bluetooth Low Energy (BLE) Protocol (Must match firmware constants) ---
BLE_SERVICE_UUID=6E400001-B5A3-F393-E0A9-E50E24DCCA9E
BLE_CHARACTERISTIC_UUID_TX=6E400003-B5A3-F393-E0A9-E50E24DCCA9E
BLE_CHARACTERISTIC_UUID_RX=6E400002-B5A3-F393-E0A9-E50E24DCCA9E
BLE_DEVICE_NAME_PREFIX=RoadGuard-ESP32
